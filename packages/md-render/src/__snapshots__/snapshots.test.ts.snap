exports[`fixture snapshots > chart-chartjs.md [full] 1`] = `
"<h1 data-source-line="1-1">Chart.js from jsDelivr</h1>
<p data-source-line="3-3">The script below points at the CDN; Inlay serves its bundled copy so the chart renders offline.</p>
<p data-source-line="5-5"><canvas id="sales" width="480" height="240"></canvas></p>
<script src="mdview://doc/__inlay/vendor/chart.js/chart.umd.js" data-inlay-vendor="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.js"></script>
<script>
  const canvas = document.getElementById('sales');
  canvas.dataset.chartjs = typeof Chart === 'function' ? 'loaded' : 'missing';
  if (typeof Chart === 'function') {
    new Chart(canvas, {
      type: 'bar',
      data: {
        labels: ['Jan', 'Feb', 'Mar', 'Apr'],
        datasets: [{ label: 'Sales', data: [12, 19, 7, 15], backgroundColor: '#0a84ff' }],
      },
      options: { animation: false, responsive: false },
    });
    canvas.dataset.rendered = 'true';
  }
</script>
<p data-source-line="24-24">Text after the chart.</p>"
`;

