exports[`fixture snapshots > footnotes-and-references.md [full] 1`] = `
"<h1 data-source-line="1-1">Footnotes and reference links</h1>
<p data-source-line="3-3">Here is a footnote reference<sup><a href="#fn-1" id="fnref-1" data-footnote-ref="" aria-describedby="footnote-label">1</a></sup> and another<sup><a href="#fn-note" id="fnref-note" data-footnote-ref="" aria-describedby="footnote-label">2</a></sup>.</p>
<p data-source-line="5-5">A <a href="https://example.com/ref" title="Reference title">reference link</a> and an <a href="https://example.com/implicit">implicit one</a> and a collapsed <a href="https://example.com/ref" title="Reference title">ref</a>.</p>
<p data-source-line="7-7">An image by reference: <img src="./assets/sample.svg" alt="logo"></p>
<p data-source-line="18-18"><a href="https://example.com/autolink-in-angle-brackets">https://example.com/autolink-in-angle-brackets</a></p>
<section data-footnotes="" class="footnotes"><h2 class="sr-only" id="footnote-label">Footnotes</h2>
<ol>
<li id="fn-1" data-source-line="9-9">
<p data-source-line="9-9">The first footnote. <a href="#fnref-1" data-footnote-backref="" aria-label="Back to reference 1" class="data-footnote-backref">↩</a></p>
</li>
