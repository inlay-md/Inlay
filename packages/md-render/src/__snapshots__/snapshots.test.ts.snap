exports[`fixture snapshots > fetch-toggle.md [full] 1`] = `
"<h1 data-source-line="1-1">Network access toggle</h1>
<p data-source-line="3-3">Documents cannot reach the network unless "Allow Network for This Document" is on.</p>
<p data-source-line="5-5"><output id="fetch-remote">pending</output> / <output id="fetch-local">pending</output></p>
<script>
  const report = (id, promise) =>
    promise
      .then((r) => { document.getElementById(id).textContent = \`allowed:\${r.status}\`; })
      .catch((e) => { document.getElementById(id).textContent = \`blocked:\${e.name}\`; });
  report('fetch-remote', fetch('https://example.com/'));
  report('fetch-local', fetch('assets/sample.svg'));
</script>"
`;

