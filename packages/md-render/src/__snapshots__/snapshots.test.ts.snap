"<h1 data-source-line="1-1">CDN URLs that are not rewritten</h1>
<p data-source-line="3-3">An older major of a known library stays on the CDN (the bundled copy is a different major):</p>
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<p data-source-line="7-7">A library Inlay does not bundle also stays on the CDN (allowed by the policy, needs network):</p>
<script src="https://cdn.jsdelivr.net/npm/lodash@4/lodash.min.js"></script>
<link data-source-line="10-10" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/water.css@2/out/water.css">
<p data-source-line="12-15" id="passthrough">Rendered.</p>
<script>
  document.getElementById('passthrough').dataset.lodash = typeof _ === 'function' ? 'loaded' : 'missing';
</script>"
`;

